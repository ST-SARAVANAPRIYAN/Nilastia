#!/usr/bin/env python3
import os
import json
import subprocess

def detect_gpus():
    gpus = []
    drm_dir = "/sys/class/drm"
    if not os.path.exists(drm_dir):
        return None, None
        
    for item in os.listdir(drm_dir):
        if not item.startswith("card") or "-" in item:
            continue
            
        card_path = os.path.join(drm_dir, item)
        device_dir = os.path.realpath(os.path.join(card_path, "device"))
        
        vendor_file = os.path.join(device_dir, "vendor")
        if not os.path.exists(vendor_file):
            continue
        with open(vendor_file) as f:
            vendor = f.read().strip().lower()
            
        boot_vga_file = os.path.join(device_dir, "boot_vga")
        boot_vga = "0"
        if os.path.exists(boot_vga_file):
            with open(boot_vga_file) as f:
                boot_vga = f.read().strip()
                
        render_node = ""
        for r_item in os.listdir(drm_dir):
            if r_item.startswith("renderD"):
                r_dev_dir = os.path.realpath(os.path.join(drm_dir, r_item, "device"))
                if r_dev_dir == device_dir:
                    render_node = f"/dev/dri/{r_item}"
                    break
                    
        gpus.append({
            "card": f"/dev/dri/{item}",
            "render": render_node,
            "vendor": vendor,
            "boot_vga": boot_vga
        })
        
    igpu = None
    dgpu = None
    
    if len(gpus) == 1:
        igpu = gpus[0]
    elif len(gpus) > 1:
        # Prioritize NVIDIA as dGPU, Intel as iGPU
        for g in gpus:
            if g["vendor"] == "0x10de":  # NVIDIA
                dgpu = g
            elif g["vendor"] == "0x8086":  # Intel
                igpu = g
                
        # If still not fully resolved, check boot_vga or AMD (0x1002)
        for g in gpus:
            if g == igpu or g == dgpu:
                continue
            if g["boot_vga"] == "1":
                if not igpu:
                    igpu = g
            else:
                if not dgpu:
                    dgpu = g
                    
        # General fallback to assign remaining GPUs
        for g in gpus:
            if g != igpu and g != dgpu:
                if not igpu:
                    igpu = g
                elif not dgpu:
                    dgpu = g
                    
    return igpu, dgpu

def is_ac_connected():
    power_supply_dir = "/sys/class/power_supply"
    if os.path.exists(power_supply_dir):
        for ps in os.listdir(power_supply_dir):
            type_file = os.path.join(power_supply_dir, ps, "type")
            online_file = os.path.join(power_supply_dir, ps, "online")
            if os.path.exists(type_file) and os.path.exists(online_file):
                with open(type_file) as f:
                    ps_type = f.read().strip()
                if ps_type in ["Mains", "UPS"]:
                    with open(online_file) as f:
                        online = f.read().strip()
                    return online == "1"
    return True

def notify_user(title, message, urgency="normal"):
    try:
        subprocess.run(["notify-send", "-u", urgency, "-a", "Nilastia", title, message], check=False)
    except Exception:
        pass

def main():
    # Load configuration
    config_path = os.path.expanduser("~/.config/nilastia/shell.json")
    gpu_mode = "auto"
    if os.path.exists(config_path):
        try:
            with open(config_path) as f:
                config_data = json.load(f)
                gpu_mode = config_data.get("general", {}).get("battery", {}).get("gpuMode", "auto")
        except Exception:
            pass

    igpu, dgpu = detect_gpus()
    target_render = ""
    target_label = "Auto (System Choice)"

    if gpu_mode == "igpu":
        if igpu:
            target_render = igpu["render"]
            target_label = "Integrated GPU Only"
        else:
            print("Warning: No iGPU detected, falling back to auto.")
    elif gpu_mode == "dgpu":
        if dgpu:
            target_render = dgpu["render"]
            target_label = "Discrete GPU Only"
        elif igpu:
            target_render = igpu["render"]
            print("Warning: No dGPU detected, using iGPU.")
    elif gpu_mode == "adaptive":
        if is_ac_connected():
            if dgpu:
                target_render = dgpu["render"]
                target_label = "Discrete GPU (Adaptive AC)"
            elif igpu:
                target_render = igpu["render"]
        else:
            if igpu:
                target_render = igpu["render"]
                target_label = "Integrated GPU (Adaptive Battery)"

    # Read current 95-gpu.kdl to check for changes
    gpu_kdl_path = os.path.expanduser("~/.config/niri/config.d/95-gpu.kdl")
    os.makedirs(os.path.dirname(gpu_kdl_path), exist_ok=True)
    
    current_content = ""
    if os.path.exists(gpu_kdl_path):
        try:
            with open(gpu_kdl_path) as f:
                current_content = f.read()
        except Exception:
            pass

    # Build new KDL block
    new_content = ""
    if target_render:
        new_content = f'// Auto-generated by nilastia-gpu-select. Do not edit.\ndebug {{\n    render-drm-device "{target_render}"\n}}\n'
    else:
        new_content = '// Auto-generated by nilastia-gpu-select. Do not edit.\n// Using system default GPU\n'

    if current_content != new_content:
        with open(gpu_kdl_path, "w") as f:
            f.write(new_content)
        print(f"Updated GPU configuration: {target_label}")
        
        # Check if Niri is already running (e.g. check for NIRI_SOCKET or systemctl status)
        niri_running = False
        for k in os.environ:
            if k.startswith("NIRI_SOCKET") or k.startswith("WAYLAND_DISPLAY"):
                niri_running = True
                break
        
        if niri_running:
            notify_user(
                "GPU Selection Updated",
                f"GPU profile set to <b>{target_label}</b>.<br>Please restart your desktop session to apply.",
                "critical"
            )
    else:
        print(f"GPU configuration unchanged: {target_label}")

if __name__ == "__main__":
    main()
