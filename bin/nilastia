#!/usr/bin/env python3
import os
import sys
import subprocess

# Resolve path dynamically so it works under any user and clone directory
SCRIPT_PATH = os.path.realpath(__file__)
SCRIPT_DIR = os.path.dirname(SCRIPT_PATH)
REAL_CLI = os.path.abspath(os.path.join(SCRIPT_DIR, "../cli/bin/nilastia"))

def main():
    args = sys.argv[1:]
    cmd = [REAL_CLI] + args
    try:
        res = subprocess.run(cmd, stdout=sys.stdout, stderr=sys.stderr, stdin=sys.stdin)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:
        sys.stderr.write(f"Failed to execute Nilastia CLI: {e}\n")
        sys.exit(1)

if __name__ == "__main__":
    main()
