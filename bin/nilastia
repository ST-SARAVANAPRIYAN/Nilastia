#!/usr/bin/env python3
import sys
import subprocess

REAL_CLI = "/home/saravana/projects/calestia/cli/bin/caelestia"

def main():
    args = sys.argv[1:]
    cmd = [REAL_CLI] + args
    try:
        res = subprocess.run(cmd, stdout=sys.stdout, stderr=sys.stderr, stdin=sys.stdin)
        sys.exit(res.returncode)
    except Exception as e:
        sys.stderr.write(f"Failed to execute caelestia CLI: {e}\n")
        sys.exit(1)

if __name__ == "__main__":
    main()
