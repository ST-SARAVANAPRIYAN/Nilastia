def generate_matugen(image_path):
    try:
        res = subprocess.run(["matugen", "image", image_path, "--source-color-index", "0", "--json", "hex"],
                             capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        mode = data.get("mode", "dark")
        colors = data.get("colors", {})
        converted = {}
        for k, v in colors.items():
            color_val = v.get(mode, {}).get("color", "") or v.get("default", {}).get("color", "")
            if color_val.startswith("#"):
                color_val = color_val[1:]
            
            # camelCase mapping
            parts = k.split("_")
            camel = parts[0] + "".join(p.capitalize() for p in parts[1:])
            converted[camel] = color_val
            
        scheme_data = {
            "name": "dynamic",
            "flavour": "wallpaper",
            "variant": "tonalspot",
            "mode": mode,
            "colours": converted
        }
        with open(SCHEME_FILE, "w") as f:
            json.dump(scheme_data, f, indent=2)
    except Exception as e:
        sys.stderr.write(f"Matugen failed: {e}\n")

def set_scheme(name, flavour):
    if name in SCHEMES and flavour in SCHEMES[name]:
        s = SCHEMES[name][flavour]
        scheme_data = {
            "name": name,
            "flavour": flavour,
            "variant": "tonalspot",
            "mode": s["mode"],
            "colours": s["colours"]
        }
        with open(SCHEME_FILE, "w") as f:
            json.dump(scheme_data, f, indent=2)
        print(f"Set scheme to {name} {flavour}")

def handle_record(args):
    res = subprocess.run(["pidof", "gpu-screen-recorder"], capture_output=True)
    is_running = (res.returncode == 0)

    parser = argparse.ArgumentParser(prog="nilastia record")
    parser.add_argument("-r", "--region", action="store_true", help="Record selected region")
    parser.add_argument("-s", "--sound", action="store_true", help="Record audio")
    parser.add_argument("-p", "--pause", action="store_true", help="Toggle pause recording")
    parsed_args, _ = parser.parse_known_args(args)

    if is_running:
        if parsed_args.pause:
            subprocess.run(["pkill", "-USR1", "gpu-screen-recorder"])
        else:
            subprocess.run(["pkill", "-INT", "gpu-screen-recorder"])
    else:
        if parsed_args.pause:
            return

        recs_dir = os.environ.get("NILASTIA_RECORDINGS_DIR") or os.path.expanduser("~/Videos/Recordings")
        os.makedirs(recs_dir, exist_ok=True)
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H-%M-%S")
        output_file = os.path.join(recs_dir, f"recording_{timestamp}.mp4")

        cmd = ["gpu-screen-recorder", "-o", output_file]

        if parsed_args.region:
            slurp_res = subprocess.run(["slurp"], capture_output=True, text=True)
            if slurp_res.returncode != 0 or not slurp_res.stdout.strip():
                return
            geom = slurp_res.stdout.strip()
            try:
                pos, size = geom.split(" ")
                x, y = pos.split(",")
                w, h = size.split("x")
                cmd.extend(["-w", f"{w}x{h}+{x}+{y}"])
            except Exception as e:
                sys.stderr.write(f"Failed to parse region: {e}\n")
                return
        else:
            cmd.extend(["-w", "screen"])

        if parsed_args.sound:
            cmd.extend(["-a", "default_output"])

        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    if len(sys.argv) < 2:
        return

    subcommand = sys.argv[1]

    if subcommand == "scheme":
        if len(sys.argv) > 2 and sys.argv[2] == "list":
            print(json.dumps(SCHEMES))
        elif len(sys.argv) > 2 and sys.argv[2] == "get":
            if os.path.exists(SCHEME_FILE):
                with open(SCHEME_FILE) as f:
                    data = json.load(f)
                    print(data.get("name", "catppuccin"))
                    print(data.get("flavour", "mocha"))
                    print(data.get("variant", "tonalspot"))
            else:
                print("catppuccin\nmocha\ntonalspot")
        elif len(sys.argv) > 2 and sys.argv[2] == "set":
            parser = argparse.ArgumentParser()
            parser.add_argument("-n", "--name", default="catppuccin")
            parser.add_argument("-f", "--flavour", default="mocha")
            parser.add_argument("-m", "--mode", default=None)
            parser.add_argument("--notify", action="store_true")
            args, _ = parser.parse_known_args(sys.argv[3:])
            set_scheme(args.name, args.flavour)

    elif subcommand == "wallpaper":
        parser = argparse.ArgumentParser()
        parser.add_argument("-f", "--file", default=None)
        parser.add_argument("-r", "--random", action="store_true")
        args, _ = parser.parse_known_args(sys.argv[2:])
        
        target = args.file
        if args.random or not target:
            walls_dir = os.path.expanduser("~/Pictures/Wallpapers")
            if os.path.exists(walls_dir):
                files = [os.path.join(walls_dir, f) for f in os.listdir(walls_dir) if f.lower().endswith(('.png', '.jpg', '.jpeg', '.webp'))]
                if files:
                    import random
                    target = random.choice(files)

        if target and os.path.exists(target):
            with open(WALLPAPER_FILE, "w") as f:
                f.write(target)
            generate_matugen(target)

    elif subcommand == "record":
        handle_record(sys.argv[2:])

if __name__ == "__main__":
    main()
